{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localhost/anno117-event.schema.json",
  "title": "Anno 117 Pipe Hub event",
  "oneOf": [
    { "$ref": "#/$defs/hubStatus" },
    { "$ref": "#/$defs/stateSnapshot" },
    { "$ref": "#/$defs/sessionStart" },
    { "$ref": "#/$defs/sessionEnd" },
    { "$ref": "#/$defs/areaStatistics" }
  ],
  "$defs": {
    "base": { "type": "object", "required": ["schemaVersion", "type", "receivedAtUtc"], "properties": { "schemaVersion": { "type": "integer", "const": 1 }, "type": { "type": "string" }, "receivedAtUtc": { "type": "string", "format": "date-time" } }, "additionalProperties": true },
    "hubStatus": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["type", "hub"], "properties": { "type": { "const": "hub.status" }, "hub": { "type": "object", "required": ["status", "listener"], "properties": { "status": { "$ref": "#/$defs/status" }, "listener": { "$ref": "#/$defs/listener" } } } } }] },
    "status": { "type": "object", "required": ["hubStatus", "pipeStatus", "connectedClients", "lastMessageAtUtc", "protocolVersion", "error"], "properties": { "hubStatus": { "enum": ["Ready"] }, "pipeStatus": { "enum": ["Waiting", "Connected", "Disconnected", "Timeout", "NotFound", "Busy"] }, "connectedClients": { "type": "integer", "minimum": 0 }, "lastMessageAtUtc": { "type": ["string", "null"], "format": "date-time" }, "protocolVersion": { "type": ["integer", "null"] }, "error": { "type": ["string", "null"] } } },
    "listener": { "type": "object", "required": ["lanEnabled", "bindAddress", "port", "state", "connectedClients", "error"], "properties": { "lanEnabled": { "type": "boolean" }, "bindAddress": { "type": "string", "format": "ipv4" }, "port": { "type": "integer", "minimum": 1024, "maximum": 65535 }, "state": { "type": "string" }, "connectedClients": { "type": "integer", "minimum": 0 }, "error": { "type": ["string", "null"] } } },
    "stateSnapshot": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["type", "snapshots"], "properties": { "type": { "const": "state.snapshot" }, "snapshots": { "type": "array", "items": { "$ref": "#/$defs/areaStatistics" } } } }] },
    "sessionStart": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["type", "session"], "properties": { "type": { "const": "session.start" }, "session": { "type": "object", "required": ["sessionName"], "properties": { "sessionName": { "type": "string" } } } } }] },
    "sessionEnd": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["type"], "properties": { "type": { "const": "session.end" } } }] },
    "areaStatistics": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["type", "statistics"], "properties": { "type": { "const": "area.production.statistics" }, "statistics": { "$ref": "#/$defs/statistics" } } }] },
    "statistics": { "type": "object", "required": ["sessionId", "islandId", "areaIndex", "sessionGuid", "areaName", "rawTimestamp", "entries"], "properties": { "sessionId": { "type": "integer", "minimum": 0 }, "islandId": { "type": "integer", "minimum": 0 }, "areaIndex": { "type": "integer", "minimum": 0 }, "sessionGuid": { "type": "integer" }, "areaName": { "type": "string" }, "rawTimestamp": { "type": "integer" }, "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } } } },
    "entry": { "type": "object", "required": ["productGuid", "productGeneration", "productConsumption", "productDelta", "perfectProductGeneration", "perfectProductConsumption", "amountOfBuildings", "totalMaintenance", "totalIncome", "totalProfit", "summedProductivity", "averageProductivity", "workforceGuidToAmount", "buildingGuidToAmount"], "properties": { "productGuid": { "type": "integer" }, "productGeneration": { "type": "number" }, "productConsumption": { "type": "number" }, "productDelta": { "type": "number" }, "perfectProductGeneration": { "type": "number" }, "perfectProductConsumption": { "type": "number" }, "amountOfBuildings": { "type": "integer" }, "totalMaintenance": { "type": "integer" }, "totalIncome": { "type": "number" }, "totalProfit": { "type": "integer" }, "summedProductivity": { "type": "number" }, "averageProductivity": { "type": "number" }, "workforceGuidToAmount": { "$ref": "#/$defs/guidAmount" }, "buildingGuidToAmount": { "$ref": "#/$defs/guidAmount" } } },
    "guidAmount": { "type": "object", "additionalProperties": { "type": "integer" } }
  }
}
